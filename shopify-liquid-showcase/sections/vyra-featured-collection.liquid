{%- assign featured_collection = section.settings.collection -%}
<div class="vyra-featured vyra-section" id="featured-{{ section.id }}">
  <div class="vyra-container">
    <div class="vyra-section-heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vyra-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.description != blank -%}
        <p class="vyra-section-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="vyra-products" role="list" style="--vyra-grid-columns: {{ section.settings.columns }};">
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        {%- for card_product in featured_collection.products limit: section.settings.products_to_show -%}
          <li class="vyra-product-slot">
            {%- liquid
              assign card_loading = 'lazy'
              assign card_priority = 'auto'
              if forloop.first and section.index == 1
                assign card_loading = 'eager'
                assign card_priority = 'high'
              endif
            -%}
            {% render 'vyra-product-card', card_product: card_product, image_loading: card_loading, image_priority: card_priority %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="vyra-product-slot">
            <article class="vyra-product-card vyra-product-card--placeholder">
              <div class="vyra-product-image vyra-product-image--placeholder" aria-hidden="true">
                {{ 'product-' | append: i | placeholder_svg_tag: 'vyra-placeholder-svg' }}
                <span class="vyra-demo-pill">Demo</span>
              </div>
              <div class="vyra-product-details">
                <h2 class="vyra-product-title">Producto de ejemplo {{ i }}</h2>
                <p class="vyra-product-hint">Elegí una colección para mostrar productos reales.</p>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if featured_collection != blank and featured_collection.products_count > section.settings.products_to_show -%}
      <a class="vyra-text-link" href="{{ featured_collection.url }}">Ver toda la colección <span aria-hidden="true">↗</span></a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Colección destacada",
  "tag": "section",
  "class": "vyra-section-wrap",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Nueva temporada"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Piezas para todos los días"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Una selección cuidada de productos. Configurá la colección desde el editor del tema."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Cantidad de productos",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas en escritorio",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    { "name": "Colección destacada" }
  ]
}
{% endschema %}
